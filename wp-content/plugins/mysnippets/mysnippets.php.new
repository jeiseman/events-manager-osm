if ( ! defined( 'ABSPATH' ) ) exit; // Exit if accessed directly

add_shortcode('ramble-tickets', 'ramble_tickets');
function ramble_tickets()
{
	$ret = '<noscript><a href="https://www.eventbrite.com/e/revolutionary-ramble-2023-registration-452386840217" rel="noopener noreferrer" target="_blank">Register Here</a></noscript><button id="eventbrite-widget-modal-trigger-452386840217" type="button" style="height: 50px; border-radius: .5em;">Register Here</button>';
    $ret .= '<script src="https://www.eventbrite.com/static/widgets/eb_widgets.js"></script>';
	$ret .= '<script type="text/javascript">
    var exampleCallback = function() {
        console.log("Order complete!");
    };

    window.EBWidgets.createWidget({
        widgetType: "checkout",
        eventId: "452386840217",
        modal: true,
        modalTriggerElementId: "eventbrite-widget-modal-trigger-452386840217",
        onOrderComplete: exampleCallback
    });
</script>';
	return $ret;
}
 
add_shortcode('ramble-open-slots', 'ramble_open_slots');
function ramble_open_slots()
{
    $ret = "";
    $open_slots = 0;
    $sheet_count = 0;
    $task_count = 0;
    $sheets_query = new WP_Query( array(
        'post_type' => 'dlssus_sheet',
        'post_status' => 'publish',
        'ends_with' => '2022',
        'posts_per_page' => -1
    ) );
    while ($sheets_query->have_posts()) {
        $sheets_query->the_post();
        $sheet_count++;
        $sheet_id = get_the_ID();
        $tasks_query = new WP_Query( array(
            'post_parent' => $sheet_id,
            'post_status' => 'publish',
            'post_type' => 'dlssus_task',
            'posts_per_page' => -1
        ) );
        while ($tasks_query->have_posts()) {
            $tasks_query->the_post();
            $task_id = get_the_ID();
            $num_slots = get_post_meta($task_id, 'dlssus_qty', true);
            if (!empty($num_slots)  && $num_slots > 0) {
                $signups_query = new WP_Query( array(
                    'post_parent' => $task_id,
                    'post_status' => 'publish',
                    'post_type' => 'dlssus_signup',
                    'posts_per_page' => -1
                ) );
                $cnt = $num_slots - $signups_query ->found_posts;
                if ($cnt > 0) {
                    $open_slots += $cnt;
                    $ret .= $cnt . ', ' . get_post_field( 'post_title', $task_id ) . '<br />';
                }
            }
        }
    }
    return $open_slots;
}
add_filter( 'generate_elements_admin_menu_capability', function() {
    return 'edit_posts';
} );
add_filter( 'generate_elements_metabox_ajax_allow_editors', function() {
    return true;
} );
add_filter( 'wp_mail_from', 'bk_mail_from_address' );
function bk_mail_from_address( $email ) {
    if (empty($email) || $email == "wordpress@rambleride.org")
        $email = 'registration@rambleride.org';
    return $email;
}
add_filter( 'wp_mail_from_name', 'bk_mail_from_name' );
function bk_mail_from_name( $from_name ) {
    if (empty($from_name) || $from_name == "WordPress")
        $from_name = 'Revolutionary Ramble Registration';
    return $from_name;
}
